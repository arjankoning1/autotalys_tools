#!/bin/sh
# D. Rochman, NRG 2007-2014
#             PSI 2015
# script to run NJOY and produce covariance plots and processed covariances in
# different groups
#                             
#                                                   
# Two programs are necessary:
# 1) njoy (can be obtained from the NEA or RSICC)
# 2) njoycovx (can be obtained from the TENDL website: ftp://ftp.nrg.eu/pub/www/talys/tendl2012/processing.html)
#
#                             
#                                                   
NOW=$(date +"%m-%d-%Y")
NOW2=$(date +"%r")
echo ''
echo '#############################################'
echo "#    D. Rochman, NRG, 2007-2014"
echo "#                PSI, 2015"
echo "#    Version 1.3 (14/07/2017)    "
echo "#    Starting time: $NOW, $NOW2"
echo "#"
echo "#"
START=$(date +%s)
year=$(date +"%Y")
echo '#'

if [ $# -eq 0 ] ; then
  echo "#       $0 [option] [value]"
  echo "#"
  echo "#    Example: $0 -file Tc99-n.tendl" 
  echo "#    Example: $0 -file Tc99-n.tendl -group 33"
  echo "#  "
  echo "#   General NJOY parameters"
  echo "#"
  echo "#       -file "
  echo "#                  endf input file [no default, must be present]"
  echo "#"
  echo "#       -outname "
  echo "#                  output name [default: out]"
  echo "#"
  echo "#       -njoy "
  echo "#                  Use NJOY version [default: njoy-2016.78]"
  echo "#"
  echo "#       -bin "
  echo "#                  Use bin path [default: ~/bin]"
  echo "#"
  echo "#       -purr "
  echo "#                  Use module purr (not necessary) [default: n] (allowed: y/n)"
  echo "#"
  echo "#       -covx "
  echo "#                  Use covx binary [default: njoycovx]"
  echo "#"
  echo "#       -group "
  echo "#                  Use group [default: 187] (allowed 27, 30, 33, 35, 44, 50, 68, 69,"
  echo "#                                                    70, 80, 172, 174, 175b, 187, 238,"
  echo "#                                                    239, 315, 620, 640, 1968)"
  echo "#                  Note: 33, 44 and 238 groups are not standard-njoy groups"    
  echo "#"
  echo "#       -temp "
  echo "#                  Use temperature [default: 300] "
  echo "#"
  echo "#       -show "
  echo "#                  Print njoy output [default: n] "
  echo "#"
  echo "#       -single "
  echo "#                  All cvx files (cross sections, nubar...) in a single file"
  echo "#                                            (allowed y/n)  [default: y] "
  echo "#"
  echo '#############################################'
  echo ''
  exit
fi

#
################################################################################
# Initialization (default values) of variables
################################################################################
#
njoy=njoy
bin="${AUTOTALYS_HOME:-$HOME}/bin/"
covx=njoycovx
group=187
temp=300
purr=n
single=y
endffile=xxx
outname=out
show=n

while [ $# -ge 1 ] ; do
  case $1 in
    -file)     endffile=$2;shift 2;;
    -bin)      bin=$2;shift 2;;
    -njoy)     njoy=$2;shift 2;;
    -covx)     covx=$2;shift 2;;
    -group)    group=$2;shift 2;;
    -outname)  outname=$2;shift 2;;
    -temp)     temp=$2;shift 2;;
    -purr)     purr=$2;shift 2;;
    -single)   single=$2;shift 2;;
    -show)     show=$2;shift 2;;
    *)  echo "Option [$1] invalid";exit;;
  esac
done

# find if the temperature contains a "."
echo "$temp" | grep  '\.' > /dev/null 2>&1
if [ "$?" -ne 0 ];then
 temp=${temp}.
fi


if   [ $group == 187 ] ; then groupA=10
elif [ $group == 239 ] ; then groupA=2 
elif [ $group == 27 ] ;  then groupA=4 
elif [ $group == 50 ] ;  then groupA=5 
elif [ $group == 68 ] ;  then groupA=6 
elif [ $group == 69 ] ;  then groupA=9 
elif [ $group == 1968 ] ;then groupA=20
elif [ $group == 35 ] ;  then groupA=8 
elif [ $group == 315 ] ; then groupA=21
elif [ $group == 172 ] ; then groupA=22 
elif [ $group == 174 ] ; then groupA=16 
elif [ $group == 175b ] ;then groupA=23 
elif [ $group == 30 ];   then groupA=3 
elif [ $group == 33 ];   then groupA=1
elif [ $group == 44 ];   then groupA=1
elif [ $group == 238 ];  then groupA=1
elif [ $group == 70 ];   then groupA=11
elif [ $group == 620 ];  then groupA=12 
elif [ $group == 80 ];   then groupA=13
elif [ $group == 640 ];  then groupA=15 
else
 echo "#  "
 echo "#    ---> group $group not allowed"
 echo "#  "
 echo '#############################################'
 echo ""
 exit
fi
# check if the input file is present
if [ $endffile == xxx ] ; then
  echo " -file MUST be specified "
  exit
fi
if [ ! -f $endffile ];then
 echo "#  "
 echo "#    ---> File $endffile not found"
 echo "#  "
 echo '#############################################'
 echo ""
 exit
fi
# check if the binary-path exists
if [ ! -d $bin ];then
 echo "#  "
 echo "#    ---> Path $bin not found"
 echo "#  "
 echo '#############################################'
 echo ""
 exit
fi
# check if njoy exists
if [ ! -f $bin/$njoy ];then
 echo "#  "
 echo "#    ---> njoy not found ($bin/$njoy)"
 echo "#  "
 echo '#############################################'
 echo ""
 exit
fi
# check if njoycovx exists
if [ ! -f $bin/$covx ];then
 echo "#  "
 echo "#    ---> covx not found ($bin/$covx)"
 echo "#  "
 echo '#############################################'
 echo ""
 exit
fi


cp $endffile tape20
MAT=`head -2 tape20 | tail -1 | colrm 1 66 | colrm 5`

# test if MF31 is given
foundMF31=1
grep -q "${MAT}3145.    1" tape20;testone=$?
if [ "$testone" == "1" ]; then echo " ---> MF 31 not found (might be ok)"; foundMF31=0;fi
# test if MF34 is given
foundMF34=1
grep -q "${MAT}34  2    1" tape20;testone=$?
if [ "$testone" == "1" ]; then echo " ---> MF 34 not found (might be ok)"; foundMF34=0;fi
# test if MF35 is given
foundMF35=1
grep -q "${MAT}35 18    1" tape20;testone=$?
if [ "$testone" == "1" ]; then echo " ---> MF 35 not found (might be ok)"; foundMF35=0;fi




echo ""
echo "#    running NJOY version $njoy on file $endffile with $group groups at ${temp} Kelvin"
if [ "$single" == "n" ];then
 echo "#    with the single option $single (separated cvx files)" 
else
 echo "#    with the single option $single (concatenated cvx files)" 
fi
echo "#    "
echo "#   These NJOY inputs have been tested for NJOY-2012, update 50, using TENDL files and "
echo "#   ENDF/B-VII.1 files                                                                 "
echo ""




cat>input <<EOF
 moder
 20 -21 /
 reconr
 -21 -22 /
 'pendf tape for MAT=$MAT  mat $endffile evaluation'/
 $MAT 0 0
 .001 /
 0/
 broadr
 -21 -22 -23 /
 $MAT 1 0 0 0 / 
 .001/
 ${temp}
 0/
 unresr
 -21 -23 -24
 $MAT 1 1 1
 ${temp}
 1.e10
 0/
 heatr
 -21 -24 -25/
 ${MAT} 1 0 0 0 2/
 444/
EOF
if [ $purr == y ] ;then
cat>>input <<EOF
 purr
 -21 -25 -27
 $MAT 1 1 40 100 /
 ${temp}/
 1.e10/
 0/
EOF
fi
cat>>input <<EOF
 groupr
  -21  -25  0  91 /
  $MAT $groupA 0 2 1 1 1 0 /
 '  MAT=$MAT  PSI-${year} ${USER}'/
 ${temp} /
 1.e10 /
EOF
if [ $groupA == 1 ] ;then
 if [ $group == 33 ] ;then
cat>>input <<EOF
 33
 1.000-05 1.000-01 5.400-01 4.000+00 8.315+00 1.371+01 
 2.260+01 4.017+01 6.790+01 9.166+01 1.486+02 3.043+02 
 4.540+02 7.485+02 1.234+03 2.035+03 3.355+03 5.531+03 
 9.119+03 1.503+04 2.479+04 4.087+04 6.738+04 1.111+05 
 1.832+05 3.020+05 4.979+05 8.209+05 1.353+06 2.231+06 
 3.679+06 6.065+06 1.000+07 1.964+07
EOF
 elif  [ $group == 44 ] ;then
cat>>input <<EOF
 44
 1.0000-5 3.0000-3 7.5000-3 1.0000-2 2.5300-2 3.0000-2
 4.0000-2 5.0000-2 7.0000-2 1.0000-1 1.5000-1 2.0000-1
 2.2500-1 2.5000-1 2.7500-1 3.2500-1 3.5000-1 3.7500-1
 4.0000-1 6.2500-1 1.0000+0 1.7700+0 3.0000+0 4.7500+0
 6.0000+0 8.1000+0 1.0000+1 3.0000+1 1.0000+2 5.5000+2
 3.0000+3 1.7000+4 2.5000+4 1.0000+5 4.0000+5 9.0000+5
 1.4000+6 1.8500+6 2.3540+6 2.4790+6 3.0000+6 4.8000+6
 6.4340+6 8.1873+6 2.0000+7 
EOF
 else
cat>>input <<EOF
 238 
 1.0000E-05 1.0000E-04 5.0000E-04 7.5000E-04 1.0000E-03 1.2000E-03
 1.5000E-03 2.0000E-03 2.5000E-03 3.0000E-03 4.0000E-03 5.0000E-03
 7.5000E-03 1.0000E-02 2.5300E-02 3.0000E-02 4.0000E-02 5.0000E-02
