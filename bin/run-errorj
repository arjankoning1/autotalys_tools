count=`grep -c "33  1    1" tape26`
if [ $count -gt 0 ];then
 if [ "$single" != "n" ];then
  ###############################################################
  #  -concatenated cvx files (all in one for MF 31,32-33,       #
  #   and 35)                                                   #
  #  -mf34 is not included in the concatenated cvx file         #
  #   since shark-x doesn't use it                              #
  #  -for mf35, we use only the pfns at thermal energy          #
  ###############################################################
  #
  # tape45 : mf31
  # tape26 : mf32-33
  # tape32 : mf34
  # tape28 : mf35 thermal
  # tape29 : mf35 100 keV
  # tape30 : mf35 1   MeV
  #
  if [ -s tape45 ];then
   #
   # put together tape45 and tape26 
   #
   #
   # take first the energy structure and nubar
   #
   endmf1=`grep -n "3345.    1" tape45 | head -1 | awk 'BEGIN {FS=":"} {print $1 - 2}'`
   head -$endmf1 tape45 > tape100
   #
   # take the cross sections from tape26
   #
   if [ -s tape26 ];then
    startmf3=`grep -n " 3...    1" tape26  | head -1 | awk 'BEGIN {FS=":"} {print $1 - 1}'`
    total26=`wc tape26 | awk '{print $1}'`
    top=`expr $total26 - $startmf3`
   else
    echo " ... tape26 does not exist (MF32-33), problem..."
    exit
   fi
   tail -$top tape26 > tape101
   #
   # remove mf33
   #
   count=`grep -c "33  1    1" tape101`
   if [ $count -gt 0 ];then
    endmf3=`grep -n "33  1    1" tape101  | head -1 | awk 'BEGIN {FS=":"} {print $1 - 1}'`
    head -$endmf3 tape101 >>tape100
   else
    count=`grep -c "33  .    1" tape101`
    if [ $count -gt 0 ];then
     endmf3=`grep -n "33  .    1" tape101  | head -1 | awk 'BEGIN {FS=":"} {print $1 - 1}'`
     head -$endmf3 tape101 >>tape100
    fi
   fi
   #
   # put nubar covariances
   #
   startmf31=`grep -n "3345.    1" tape45 | head -1 | awk 'BEGIN {FS=":"} {print $1 - 1}'`
   total45=`wc tape45 | awk '{print $1}'`
   top31=`expr $total45 - $startmf31`
   tail -$top31 tape45 >> tape100
   head -n -3 tape100 > tape101
   mv tape101 tape100
   #
   # put the mf33 
   #
   endmf3=`grep -n "33  1    1" tape26  | head -1 | awk 'BEGIN {FS=":"} {print $1 - 1}'`
   if [ "$endmf3" == "" ];then 
    endmf3=`grep -n "33  .    1" tape26  | head -1 | awk 'BEGIN {FS=":"} {print $1 - 1}'`
   fi
   mf33=`expr $total26 - $endmf3`
   tail -$mf33 tape26 >> tape100  
  else
   cp tape26 tape100
  fi 
  if [ -s tape28 ];then
   #
   # put together tape100 and tape28 
   #
   endmf3=`grep -n "33...    1" tape100  | head -1 | awk 'BEGIN {FS=":"} {print $1 - 2}'`
   head -$endmf3 tape100 > tape101
   #
   # take the pfns from tape28
   #
   line=`tail -1 tape101 | sed 's/3  099999/5  099999/g'`
   #grep ' 5 18    ' tape28 >>tape101
   grep ' 5 18   ' tape28 >>tape101
   #grep ' 5 18   ' tape28
   echo "$line" >>tape101
   #
   # put the covariance matrix from tape100
   #
   mf33=`grep -n "33...    1" tape100 | head -1 | awk 'BEGIN {FS=":"} {print $1 - 2}'`
   total=`wc tape100 | awk '{print $1}'`
   mf33=`expr $total - $mf33` 
   tail -$mf33 tape100 >>tape101
   head -n -3 tape101 > tape102
   mv tape102 tape101
   #
   # put the covariance matrix from tape29 (tape28 was used before)
   #
   mf35=`grep -n "35...    1" tape29 | head -1 | awk 'BEGIN {FS=":"} {print $1 - 1}'`
   total=`wc tape29 | awk '{print $1}'`
   mf35=`expr $total - $mf35` 
   tail -$mf35 tape29 >>tape101
   mv tape101 tape100
  fi
  ln -s -f tape100 cvf.$outname
  if [ -d exc-d ];then rm -r exc-d;fi
  mkdir exc-d
  ${bin}/${covx} $outname >>njoy.out
  if [ -f corr.matrix ];then mv corr.matrix $outname-njoy-cov-${group}g.all.${temp}K.matrix;fi
  rm cvf.$outname
  if [ -f cvx.$outname ];then mv cvx.$outname $outname.${group}g.cross.${temp}K.cvx;fi

 fi
else
 echo "No MF33 found in tape26"
fi


echo '#    cleaning' 
if [ -f tape100 ];then rm tape100;fi
if [ -f tape33 ];then rm tape33;fi
if [ -f tape32 ];then rm tape32;fi
if [ -f tape42 ];then rm tape42;fi
if [ -f tape28 ];then rm tape28;fi
if [ -f tape29 ];then rm tape29;fi
if [ -f tape30 ];then rm tape30;fi
if [ -f tape39 ];then rm tape39;fi
if [ -f tape40 ];then rm tape40;fi
if [ -f tape38 ];then rm tape38;fi
if [ -f tape43 ];then rm tape43;fi
if [ -f tape26 ];then rm tape26;fi
if [ -f tape34 ];then rm tape34;fi
if [ -f tape21 ];then rm tape21;fi
if [ -f tape22 ];then rm tape22;fi
if [ -f tape23 ];then rm tape23;fi
if [ -f tape24 ];then rm tape24;fi
if [ -f tape25 ];then rm tape25;fi
if [ -f tape45 ];then rm tape45;fi
if [ -f tape27 ];then rm tape27;fi
if [ -f tape20 ];then rm tape20;fi
if [ -f tape50 ];then rm tape50;fi
if [ -f tape91 ];then rm tape91;fi
if [ -f group ]; then rm group;fi
if [ -f input ]; then rm input;fi
if [ -f njoy.out ]; then rm njoy.out;fi
if [ -f rsd.$outname ];then rm rsd.$outname;fi
if [ -f rsx.$outname ];then rm rsx.$outname;fi
if [ -f exc.$outname ];then rm exc.$outname;fi
if [ -f $outname-out.errorj ];then rm $outname-out.errorj;fi
if [ -d exc-d ]; then rm -r exc-d;fi
if [ -f cvf.$outname ];then rm cvf.$outname;fi
echo ''
echo ''
