EOF
 fi
fi
cat>>input <<EOF
 3/
EOF
# 3 221 'thrsct'/
cat>>input <<EOF
 3 251 'mubar'/
 3 252 'xi'/
EOF
if [ $foundMF31 -eq 1 ];then
 # test if MT455 is present
 mt455=`grep -c "$MAT 1455" $endffile`
 if [ $mt455 -gt 0 ];then
 cat>>input <<EOF
 3 452 'nu' /
 3 455 'nu' /
 3 456 'nu' /
EOF
 else
 cat>>input <<EOF
 3 452 'nu' /
 3 456 'nu' /
EOF
 fi
fi
# cat>>input <<EOF
# 3 253 'gamma'/
#EOF
if [ $foundMF35 -eq 1 ];then
 cat>>input <<EOF
 5 18  'xi' /
EOF
fi
# 6/
# 6 221 'thrsct'/
cat>>input <<EOF
 0/
 0/
EOF

if [ $foundMF31 -eq 1 ];then
 cat>>input <<EOF
 --
 -- process mf31
 errorr
 -21 0 91  45 0 0 /
 $MAT $groupA 6 1 1/
 1   ${temp}   /
 0 31 1 1 -1 /
EOF
 if [ $groupA == 1 ] ;then
  if [ $group == 33 ] ;then
  cat>>input <<EOF
 33
 1.000-05 1.000-01 5.400-01 4.000+00 8.315+00 1.371+01 
 2.260+01 4.017+01 6.790+01 9.166+01 1.486+02 3.043+02 
