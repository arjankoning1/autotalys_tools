  echo
  echo "REQUIRED"
  echo "       Codes and scripts needed to run Autotalys:"
  echo
  echo "       TALYS     : nuclear reaction program"
  echo "       TASMAN    : TALYS input randomizer, optimization and covariance program"
  echo "       TEFAL     : ENDF-6 formatting program"
  echo "       TARES     : program for ENDF-6 resonance and covariance data"
  echo "       TAFIS     : program for ENDF-6 fission (nubar) parameters and covariances"
  echo "       TANES     : program for ENDF-6 fission neutron spectrum and covariances"
  echo "       autonorm  : program to normalize TALYS results to evaluated or experimental data"
  echo "       autobnl   : script to run the checking codes CHECKR, FIZCON, PSYCHE and INTER"
  echo "       CHECKR    : BNL code to check ENDF-6 formats"
  echo "       FIZCON    : BNL code to check procedures in ENDF-6 data libraries"
  echo "       PSYCHE    : BNL code to perform physics checks of ENDF-6 data libraries"
  echo "       autoprepro: script to run the PREPRO codes"
  echo "       PREPRO    : Lawrence Livermore pre-processing codes LINEAR, FIXUP, etc."
  echo "       FUDGE     : Lawrence Livermore GNDS formatting and checking code system"
  echo "       autonjoy  : script to run NJOY"
  echo "       NJOY      : Los Alamos processing program"
  echo "       autofudge : script to run the FUDGE codes"
  echo "       automcnp  : script to run MCNP"
  echo "       MCNP      : Los Alamos Monte Carlo transport program (not implemented)"
