#!/bin/bash
#
#
echo
echo "       Autotalys-2.25 (Version October 5 2026) (C) Copyright 2026 Arjan Koning All Rights Reserved"
echo
echo $0 $@
echo
#
#      autotalys - Script to run programs of the TALYS nuclear data system"
#
################################################################################
#
#               STRUCTURE OF THE AUTOTALYS SCRIPT
#
# A Input and Initialization
#   A.1 Output of all options
#   A.2 Initialization (default values) of variables
#   A.3 Read command line arguments
#   A.4 Prevent unlogical option combinations
#   A.5 Set nuclide symbols
#   A.6 Set path names and executables
#   A.7 Output of all flags and options
#   A.8 Nuclide initialization
#   A.9 Make path for target nuclide and create directories
# B TALYS run
#   B.1 Set incident energies
#   B.2 Create standard TALYS input file
#   B.3 Specific additions to the TALYS input file
#   B.4 Copy TALYS input files and go to talyscalc directory
#   B.5 Optional normalization to existing data, i.e. run TALYS again
# C TEFAL: ENDF file creation
#   C.1 Create TEFAL input files
#   C.2 Resonance files
#   C.3 nubar files
#   C.4 PFNS files
#   C.5 Further input for TEFAL
#   C.6 Definition of specific libraries
#   C.7 Loop over various types of libraries and run TEFAL and associated codes
#   C.8 Run TEFAL and copy files
#   C.9 Run CHECKR, FIZCON and PSYCHE
#   C.10 For EAF: Run PREPRO for pointwise data
#   C.11 Copy files with reaction information
# D TASMAN: Covariance calculation or optimization
#   D.1 Create TASMAN input file
#   D.2 Create directory for covariance calculation or optimization
#   D.3 Run TASMAN and copy results to talyscalc directory
#   D.4 Run TEFAL for ENDF file with covariance information
#   D.5 Run CHECKR, FIZCON and PSYCHE
# E Checking, processing and plotting
#   E.1 FUDGE
#   E.2 NJOY for pendfN and ACE
#   E.3 PREPRO and INTER
#   E.4 MCNP
#   E.5 Comparison and covariance plots with NJOY and ERRORJ
#   E.6 Plotting of results versus EXFOR and other libraries
# F Clean up
################################################################################
start=`date +%F,%T`
echo "________Script [$0] starting on: `uname -n` at: $start"
echo
#
################################################################################
echo "### A Input and Initialization"
################################################################################
#
################################################################################
echo "  # A.1 Output of all options"
################################################################################
#
if [ $# -eq 0 ] ; then
  echo "AUTOTALYS                                                              AUTOTALYS"
  echo
  echo
  echo
  echo "NAME"
  echo "       autotalys - Script to run programs of the TALYS nuclear data system and"
