#
# Functions 
#
cpalways () {
  local pattern="$1"
  local dest="$2"

  for i in $pattern ; do
    if [ -e "$i" ] ; then
      cp -f -- "$i" "$dest"
    fi
  done
}
die() {
  echo "*** AUTOTALYS error: $*" >&2
  exit 1
}
usage_error() {
  echo "*** AUTOTALYS error: $*" >&2
  exit 2
}
require_exe() {
  [ -x "$1" ] || die "executable not found: $1"
}

cd_or_die() {
  cd "$1" || die "cannot enter directory: $1"
}
need_value() {
  if [ $# -lt 2 ]; then
    usage_error "option $1 requires a value"
  fi
}
#
################################################################################
echo "  # A.3 Read command line arguments"
################################################################################
#
while [ $# -ge 1 ] ; do
  case $1 in
    -proj) need_value "$@"; proj=$2;shift 2;;
    -element) need_value "$@"; element=$2;shift 2;;
    -mass) need_value "$@"; mass=$2;shift 2;;
    -Ltarget) need_value "$@"; Ltarget=$2;shift 2;;
    -Liso) need_value "$@"; Liso=$2;shift 2;;
    -bins) need_value "$@"; bins=$2;shift 2;;
    -binsrand) need_value "$@"; binsrand=$2;shift 2;;
    -ntalys) need_value "$@"; ntalys=$2;shift 2;;
    -ldmodel) need_value "$@"; ldmodel=$2;shift 2;;
    -psfmodel) need_value "$@"; psfmodel=$2;shift 2;;
    -fismodel) need_value "$@"; fismodel=$2;shift 2;;
    -nburn) need_value "$@"; nburn=$2;shift 2;;
    -talysversion) need_value "$@"; talysversion=$2;shift 2;;
    -tefalversion) need_value "$@"; tefalversion=$2;shift 2;;
    -tasmanversion) need_value "$@"; tasmanversion=$2;shift 2;;
    -energyfile) need_value "$@"; energyfile=$2;shift 2;;
    -tasmanfile) need_value "$@"; tasmanfile=$2;shift 2;;
    -talysfile) need_value "$@"; talysfile=$2;shift 2;;
    -tefalfile) need_value "$@"; tefalfile=$2;shift 2;;
    -talysdir) need_value "$@"; talysdir=$2;shift 2;;
    -copydir) need_value "$@"; copydir=$2;shift 2;;
    -movedir) need_value "$@"; movedir=$2;shift 2;;
    -libname) need_value "$@"; libname=$2;shift 2;;
    -libext) need_value "$@"; libext=$2;shift 2;;
    -low)   low=1; high=0; E30=0; E60=0; E300=0; E600=0; E1000=0; shift;;
    -E30)   low=0; high=0; E30=1; E60=0; E300=0; E600=0; E1000=0; shift;;
    -E60)   low=0; high=0; E30=0; E60=1; E300=0; E600=0; E1000=0; shift;;
    -high)  low=0; high=1; E30=0; E60=0; E300=0; E600=0; E1000=0; shift;;
    -E300)  low=0; high=0; E30=0; E60=0; E300=1; E600=0; E1000=0; shift;;
    -E600)  low=0; high=0; E30=0; E60=0; E300=0; E600=1; E1000=0; shift;;
    -E1000) low=0; high=0; E30=0; E60=0; E300=0; E600=0; E1000=1; shift;;
    -thin)  thin=1;shift;;
    -nothin)  thin=0;shift;;
    -E) need_value "$@"; E=$2;shift 2;;
    -fy)  fy=1;shift;;
    -nofy)  fy=0;shift;;
    -runtalys)  runtalys=1;shift;;
    -noruntalys)  runtalys=0;shift;;
    -tables)  tables=1;shift;;
    -notables)  tables=0;shift;;
    -plot)  plot=1;shift;;
    -noplot)  plot=0;shift;;
    -Ealways)  Ealways=1;shift;;
    -noEalways)  Ealways=0;shift;;
    -endf)  endf=1;shift;;
    -noendf)  endf=0;shift;;
    -gpf)  gpf=1;shift;;
    -nogpf)  gpf=0;shift;;
    -sdefault)  sdefault=1;shift;;
    -nosdefault)  sdefault=0;shift;;
    -s0)  s0=1;shift;;
    -nos0)  s0=0;shift;;
    -s20)  s20=1;shift;;
    -nos20)  s20=0;shift;;
    -s60)  s60=1;shift;;
    -nos60)  s60=0;shift;;
    -mt)  mt=1;shift;;
    -nomt)  mt=0;shift;;
    -mtextra)  mtextra=1;shift;;
    -nomtextra)  mtextra=0;shift;;
    -lrf7)  lrf7=1;shift;;
    -nolrf7)  lrf7=0;shift;;
    -select)  select=1;shift;;
    -noselect)  select=0;shift;;
    -covrand)  covrand=1;shift;;
    -nocovrand)  covrand=0;shift;;
    -nubar)  nubar=1;shift;;
    -nonubar)  nubar=0;shift;;
    -fns)  fns=1;shift;;
    -nofns)  fns=0;shift;;
    -acf)  acf=1;shift;;
    -noacf)  acf=0;shift;;
    -eaf)  eaf=1;shift;;
    -noeaf)  eaf=0;shift;;
    -covar)  covar=1;shift;;
    -nocovar)  covar=0;shift;;
    -sens)  sens=1;shift;;
    -nosens)  sens=0;shift;;
    -ransens)  ransens=1;shift;;
    -noransens)  ransens=0;shift;;
    -morris)  morris=1;shift;;
    -nomorris)  morris=0;shift;;
    -allrandom)  allrandom=1;shift;;
    -noallrandom)  allrandom=0;shift;;
    -allprocess)  allprocess=1;shift;;
    -noallprocess)  allprocess=0;shift;;
    -weight)  weight=1;shift;;
    -noweight)  weight=0;shift;;
    -ompvar)  ompvar=1;shift;;
    -noompvar)  ompvar=0;shift;;
    -parauto)  parauto=1;shift;;
    -noparauto)  parauto=0;shift;;
    -isomer)  isomer=1;shift;;
    -noisomer)  isomer=0;shift;;
    -residual)  residual=1;shift;;
    -noresidual)  residual=0;shift;;
    -intercor)  intercor=1;shift;;
    -nointercor)  intercor=0;shift;;
    -search)  search=1;shift;;
    -nosearch)  search=0;shift;;
    -autosearch)  autosearch=1;shift;;
    -noautosearch)  autosearch=0;shift;;
    -gzip)  gzip=1;shift;;
    -nogzip)  gzip=0;shift;;
    -tar)  tar=1;shift;;
    -notar)  tar=0;shift;;
    -tarwork)  tarwork=1;shift;;
    -notarwork)  tarwork=0;shift;;
    -bnl)  bnl=1;shift;;
    -nobnl)  bnl=0;shift;;
    -prepro)  prepro=1;shift;;
    -noprepro)  prepro=0;shift;;
    -fudge)  fudge=1;shift;;
    -nofudge)  fudge=0;shift;;
    -njoy)  njoy=1;shift;;
    -nonjoy)  njoy=0;shift;;
    -purr)  purr=1;shift;;
    -nopurr)  purr=0;shift;;
    -mcnp)  mcnp=1;shift;;
    -nomcnp)  mcnp=0;shift;;
    -integral)  integral=1;shift;;
    -nointegral)  integral=0;shift;;
    -clean)  clean=1;shift;;
    -noclean)  clean=0;shift;;
    -extension) need_value "$@"; extension=$2;shift 2;;
    -nubarbase)  nubarbase=1;shift;;
    -nonubarbase)  nubarbase=0;shift;;
    -fnsbase)  fnsbase=1;shift;;
    -nofnsbase)  fnsbase=0;shift;;
    -resbase)  resbase=1;shift;;
    -noresbase)  resbase=0;shift;;
    -compact)  compact=1;shift;;
    -nocompact)  compact=0;shift;;
    -talysurr)  talysurr=1;shift;;
    -notalysurr)  talysurr=0;shift;;
    -mf33res)  mf33res=1;shift;;
    -nomf33res)  mf33res=0;shift;;
    -recoil)  recoil=1;shift;;
    -norecoil)  recoil=0;shift;;
    -talysresonance)  talysresonance=1;shift;;
    -notalysresonance)  talysresonance=0;shift;;
    -resonance)  resonance=1;shift;;
    -noresonance)  resonance=0;shift;;
    -macs)  macs=1;shift;;
    -nomacs)  macs=0;shift;;
    -levels)  levels=1;shift;;
    -nolevels)  levels=0;shift;;
    -micro)  micro=1;shift;;
    -nomicro)  micro=0;shift;;
    -best)  best=1;shift;;
    -nobest)  best=0;shift;;
    -fit)  fit=1;shift;;
    -nofit)  fit=0;shift;;
    -tasmanbest)  tasmanbest=1;shift;;
    -notasmanbest)  tasmanbest=0;shift;;
    -bestlib) need_value "$@"; bestlib=$2;shift 2;;
    -rescue)  rescue=1;shift;;
    -norescue)  rescue=0;shift;;
    -autonorm)  auto=1;shift;;
    -noautonorm)  auto=0;shift;;
    -pipefail)  pipefail=1;shift;;
    -nopipefail)  pipefail=0;shift;;
    -omponly)  omponly=1;shift;;
    -noomponly)  omponly=0;shift;;
    -subfission)  subfission=1;shift;;
    -nosubfission)  subfission=0;shift;;
    -ld)  ld=1;shift;;
    -nold)  ld=0;shift;;
    -seed) need_value "$@"; seed=$2;shift 2;;
    -offset) need_value "$@"; offset=$2;shift 2;;
    *) usage_error "invalid option [$1]" ;;
  esac
done
#
################################################################################
echo "  # A.4 Prevent unlogical option combinations"
################################################################################
#
if [ $pipefail -eq 1 ] ;then
  set -euo pipefail
fi
case "$proj" in
  n|g|p|d|t|h|a) ;;
  *)
    usage_error "invalid projectile: $proj"
    ;;
esac

if ! [[ "$element" =~ ^[A-Za-z]{1,2}$ ]]; then
  usage_error "invalid element: $element"
fi

if ! [[ "$mass" =~ ^[0-9]+$ ]] || [ "$mass" -lt 1 ]; then
  usage_error "invalid mass: $mass"
fi

if ! [[ "$Liso" =~ ^[0-4]+$ ]]; then
  usage_error "invalid liso: $Liso"
fi
if [ $search -eq 1 ] ; then
  endf=0
  covar=0
  tables=0
  plot=0
  rescue=0
  auto=0
  clean=0
  sens=0
fi
if [ $omponly -eq 1 ] ; then
  residual=0
  endf=0
  levels=0
fi
if [ $macs -eq 1 ] ; then
  endf=0
fi
if [ $ld -eq 1 ] ; then
  autosearch=0
  endf=0
  best=0
  fit=0
  tasmanbest=0
fi
if [ $ransens -eq 1 ] ; then
  covar=1
fi
if [ $covar -eq 0 ] && [ $search -eq 0 ] ; then
  ntalys=0
fi
if [ $rescue -eq 1 ] ; then
  auto=0
fi
if [ $sens -eq 1 ] ; then
  endf=0
  tables=0
  plot=0
  covar=0
  search=0
  rescue=0
  auto=0
  best=0
  fit=0
  tasmanbest=0
fi
if [ $endf -eq 0 ] ; then
  gpf=0
  mt=0
  select=0
  covrand=0
  nubar=0
  fns=0
  s0=0
  s20=0
  s60=0
  acf=0
  eaf=0
  bnl=0
  prepro=0
  fudge=0
  mcnp=0
  njoy=0
  purr=0
fi
if [ $njoy -eq 0 ] ; then
  mcnp=0
fi
if [ $runtalys -eq 0 ] ; then
  auto=0
fi
if [ $binsrand -eq 0 ] ; then
  binsrand=$bins
fi
#
################################################################################
echo "  # A.5 Set nuclide symbols"
################################################################################
#
# Remove and add leading zeroes for mass
#
mass=`printf "%03d"  $(echo $mass | sed "s/^0*//;s/^$/0/")`
#
# Produce correct string for element: only first character uppercase
#
element=`echo $element | tr A-Z a-z | awk '{print toupper(substr($0,1,1))substr($0,2)}'`
#
# Isomeric symbol
#
isosym=
Liso=`printf "%01d"  $(echo $Liso)`
case $Liso in
  1)  isosym='m';;
  2)  isosym='n';;
  3)  isosym='o';;
  4)  isosym='p';;
esac
nuclide=$element$mass$isosym
projnuc=$proj'-'$nuclide
#
################################################################################
echo "  # A.6 Set path names and executables"
################################################################################
#
###
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AUTOTALYS_HOME="$(cd "$script_dir/.." && pwd)"
export AUTOTALYS_HOME
export TALYS_DIR="$AUTOTALYS_HOME/talys"
export TEFAL_DIR="$AUTOTALYS_HOME/tefal"
export TASMAN_DIR="$AUTOTALYS_HOME/tasman"
export AUTOENDF_DIR="$AUTOTALYS_HOME/autoendf"
export PREPRO_DIR="$AUTOTALYS_HOME/PREPRO"
export NJOY_DIR="$AUTOTALYS_HOME/NJOY2016"
export BNL_DIR="$AUTOTALYS_HOME/ENDF-utility-codes"
export FUDGE_DIR="$AUTOTALYS_HOME/fudge"
export AUTOTALYS_TOOLS_DIR="$AUTOTALYS_HOME/autotalys_tools"
export PATH="$AUTOTALYS_HOME/bin:$PATH"
echo
echo "The following are local settings for this autotalys run only"
echo
echo "AUTOTALYS_HOME " $AUTOTALYS_HOME
echo "TALYS_DIR " $TALYS_DIR
echo "TEFAL_DIR " $TEFAL_DIR
echo "TASMAN_DIR " $TASMAN_DIR
echo "AUTOENDF_DIR " $AUTOENDF_DIR
echo "PREPRO_DIR " $PREPRO_DIR
echo "NJOY_DIR " $NJOY_DIR
echo "BNL_DIR " $BNL_DIR
echo "FUDGE_DIR " $FUDGE_DIR
echo "AUTOTALYS_TOOLS_DIR " $AUTOTALYS_TOOLS_DIR
echo "PATH " $PATH
echo
###
#Thome="${AUTOTALYS_HOME:-$HOME}"
#Thome="${AUTOTALYS_HOME}"
#Thome="${Thome%/}"     # remove final slash if present
bin=${AUTOTALYS_HOME}'/bin/'
talys=$bin$talysversion$extension
tefal=$bin$tefalversion$extension
tasman=$bin$tasmanversion$extension
tares=$bin'tares'
tafis=$bin'tafis'
tanes=$bin'tanes'
