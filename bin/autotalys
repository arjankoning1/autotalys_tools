run_errorj=$bin'run-errorj'
interCE=$bin'interCE'
energypath=${AUTOTALYS_HOME}'/tefal/misc/'
taresdef=${AUTOTALYS_HOME}'/tefal/misc/background'
librariespath=${HOME}'/libraries/'
resonancepath=$librariespath'resbase/'
nubarpath=$librariespath'nubarbase/'
fnspath=$librariespath'fnsbase/'
structure=${AUTOTALYS_HOME}'/talys/structure/'
#
# We run Autotalys in the current directory.
#
startdir=`pwd`
curdir=`pwd`
talyscalc=
cov=
sen=
sea=
