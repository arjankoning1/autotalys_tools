  echo
  echo "       -[no]njoy "
  echo "                 Produce ACE file with NJOY [default: -njoy]"
  echo
  echo "       -[no]purr "
  echo "                 Use PURR in NJOY [default: -nopurr]"
  echo
  echo "       -[no]mcnp "
  echo "                 Run MCNP with ACE file [default: -nomcnp]"
  echo
  echo "       -[no]integral "
  echo "                 Calculation of integral effective cross section [default: -nointegral]"
  echo
  echo
  echo "   System options"
  echo
  echo "       -[no]gzip "
  echo "                 Gzip working directory [default: -nogzip]"
  echo
  echo "       -[no]tar "
  echo "                 Tar final directory [default: -notar]"
  echo
  echo "       -[no]tarwork "
