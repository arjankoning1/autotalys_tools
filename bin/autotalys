  echo "       autotalys [option] [value]"
  echo
  echo "DESCRIPTION"
  echo "       With Autotalys, various tasks of the TALYS system can be automated."
  echo "       The tasks which can be performed are"
  echo "         DATA LIBRARY PRODUCTION"
  echo "         - Creation of an input file for TALYS"
  echo "         - Run TALYS, with or without automatic normalization"
  echo "         - Run TEFAL to produce an ENDF-6 data library"
  echo "         - Run TASMAN to randomize inputs and random data libraries, covariance matrices, optimization to experimental data and sensitivity profiles"
  echo "         - Depending on the version of this package ('T3' or 'T6'):"
  echo "           - Read prepared databases:"
  echo "             - resbase for produce resonance parameters + uncertainties"
  echo "             - nubase for produce fission parameters + uncertainties"
  echo "             - pfnsbase for produce fission neutron spectra + uncertainties"
  echo "           - Run codes:"
  echo "             - TARES to produce resonance parameters + uncertainties"
  echo "             - TAFIS to produce fission parameters + uncertainties"
  echo "             - TANES to produce fission neutron spectra + uncertainties"
  echo "         - Run CHECKR, FIZCON, PSYCHE and INTER to check data libraries"
  echo "         - Run PREPRO and FUDGE codes to check and process data libraries"
  echo "         - Run NJOY to process data library"
  echo "         - Store all x-y tables, ENDF-6 data libraries and other results in appropriate directories"
  echo
  echo "         SENSITIVITY ANALYSIS"
  echo "         - With TASMAN, nuclear model parameter sensitivities can be calculated, by linearly"
  echo "           changing the input parameters one by one, or by a Monte Carlo method."
  echo
  echo "         SEARCH (automatic optimization to experimental or evaluated data)"
  echo
  echo "       Consult the Autotalys manual in tools/doc/tools.pdf for a complete description"
  echo
  echo "   Operation mode:"
  echo
  echo "       Usage: autotalys [option] [value]"
  echo
  echo "       Some option flags should be accompanied by a value"
  echo
  echo "       Examples: autotalys -element Nb -mass 93"
  echo "                 autotalys -element U -mass 235 -noendf -high"
  echo
  echo "   General options: projectile, nuclide (range) and energies"
  echo
  echo "       -proj [projectile] "
  echo "             Projectile: n,g,p,d,t,h or a [default: -proj n]"
  echo
  echo "       -element [element]    "
  echo "                Element [default: -element Nb]"
  echo
  echo "       -mass [mass]   "
  echo "             Mass number [default: -mass 93]"
  echo
  echo "       -Ltarget [Ltarget] "
